module top(
    input clk,               // {{mhz .ClockFreq}} MHz board clock
    output tmds_clk_p,       // HDMI Clock out (+)
    output tmds_clk_n,       // HDMI Clock out (-)
    output [2:0] tmds_d_p,   // HDMI Data out (+)
    output [2:0] tmds_d_n    // HDMI Data out (-)
);

    // ==========================================
    // 1. Clock Generation (PLL)
    // ==========================================
    // HDMI requires a 5x pixel clock for serialization.
    // {{mhz .ClockFreq}} MHz * 5 = {{mul (mhz .ClockFreq) 5}} MHz
    wire clk_{{mul (mhz .ClockFreq) 5}}m;
    wire lock;
{{if eq (mhz .ClockFreq) 24}}
    rPLL #(
        .FCLKIN("24"),
        .IDIV_SEL(0),     // Divide by 1
        .FBDIV_SEL(9),    // Multiply by 10 (VCO = 240 MHz)
        .ODIV_SEL(1)      // Divide by 2 (240 / 2 = 120 MHz)
    ) pll_inst (
        .CLKIN(clk),
        .CLKOUT(clk_120m),
        .LOCK(lock),
        .CLKOUTP(), .CLKOUTD(), .CLKOUTD3(),
        .RESET(1'b0), .RESET_P(1'b0), .CLKFB(1'b0),
        .FBDSEL(6'b0), .IDSEL(6'b0), .ODSEL(6'b0),
        .PSDA(4'b0), .DUTYDA(4'b0), .FDLY(4'b0)
    );
{{else}}
    rPLL #(
        .FCLKIN("27"),
        .IDIV_SEL(0),     // Divide by 1
        .FBDIV_SEL(9),    // Multiply by 10 (VCO = 270 MHz)
        .ODIV_SEL(1)      // Divide by 2 (270 / 2 = 135 MHz)
    ) pll_inst (
        .CLKIN(clk),
        .CLKOUT(clk_135m),
        .LOCK(lock),
        .CLKOUTP(), .CLKOUTD(), .CLKOUTD3(),
        .RESET(1'b0), .RESET_P(1'b0), .CLKFB(1'b0),
        .FBDSEL(6'b0), .IDSEL(6'b0), .ODSEL(6'b0),
        .PSDA(4'b0), .DUTYDA(4'b0), .FDLY(4'b0)
    );
{{end}}
    // ==========================================
    // 2. Video Timings (720x480 @ 60Hz)
    // ==========================================
    reg [9:0] cx = 0; // X position
    reg [9:0] cy = 0; // Y position

    always @(posedge clk) begin
        if (cx == 857) begin
            cx <= 0;
            if (cy == 524)
                cy <= 0;
            else
                cy <= cy + 1;
        end else begin
            cx <= cx + 1;
        end
    end

    // CEA-861 blanking logic for 480p
    wire hsync = (cx >= 720 + 16) && (cx < 720 + 16 + 62);
    wire vsync = (cy >= 480 + 9)  && (cy < 480 + 9 + 6);
    wire de    = (cx < 720)       && (cy < 480);

    // ==========================================
    // 3. The Color
    // ==========================================
    // Make the screen RED!
    wire [7:0] red   = de ? 8'hFF : 8'h00;
    wire [7:0] green = 8'h00;
    wire [7:0] blue  = 8'h00;

    // ==========================================
    // 4. The TMDS Encoders
    // ==========================================
    wire [9:0] tmds_r, tmds_g, tmds_b;

    tmds_encoder enc_r(.clk(clk), .rst(~lock), .vd(red),   .cd(2'b00),          .vde(de), .tmds(tmds_r));
    tmds_encoder enc_g(.clk(clk), .rst(~lock), .vd(green), .cd(2'b00),          .vde(de), .tmds(tmds_g));
    tmds_encoder enc_b(.clk(clk), .rst(~lock), .vd(blue),  .cd({vsync, hsync}), .vde(de), .tmds(tmds_b));

    // ==========================================
    // 5. Hardware Serializers (Gowin Primitives)
    // ==========================================
    wire clk_serial;
    wire [2:0] tmds_serial;

    // Blue channel (D2)
    (* IOLOGIC_FCLK="clk_{{mul (mhz .ClockFreq) 5}}m" *)
    OSER10 oser_b (
        .Q(tmds_serial[0]),
        .D0(tmds_b[0]), .D1(tmds_b[1]), .D2(tmds_b[2]), .D3(tmds_b[3]), .D4(tmds_b[4]),
        .D5(tmds_b[5]), .D6(tmds_b[6]), .D7(tmds_b[7]), .D8(tmds_b[8]), .D9(tmds_b[9]),
        .PCLK(clk), .FCLK(clk_{{mul (mhz .ClockFreq) 5}}m), .RESET(~lock)
    );
    defparam oser_b.GSREN = "false";
    defparam oser_b.LSREN = "false";
    TLVDS_OBUF tlvds_b (.O(tmds_d_p[0]), .OB(tmds_d_n[0]), .I(tmds_serial[0]));

    // Green channel (D1)
    (* IOLOGIC_FCLK="clk_{{mul (mhz .ClockFreq) 5}}m" *)
    OSER10 oser_g (
        .Q(tmds_serial[1]),
        .D0(tmds_g[0]), .D1(tmds_g[1]), .D2(tmds_g[2]), .D3(tmds_g[3]), .D4(tmds_g[4]),
        .D5(tmds_g[5]), .D6(tmds_g[6]), .D7(tmds_g[7]), .D8(tmds_g[8]), .D9(tmds_g[9]),
        .PCLK(clk), .FCLK(clk_{{mul (mhz .ClockFreq) 5}}m), .RESET(~lock)
    );
    defparam oser_g.GSREN = "false";
    defparam oser_g.LSREN = "false";
    TLVDS_OBUF tlvds_g (.O(tmds_d_p[1]), .OB(tmds_d_n[1]), .I(tmds_serial[1]));

    // Red channel (D0)
    (* IOLOGIC_FCLK="clk_{{mul (mhz .ClockFreq) 5}}m" *)
    OSER10 oser_r (
        .Q(tmds_serial[2]),
        .D0(tmds_r[0]), .D1(tmds_r[1]), .D2(tmds_r[2]), .D3(tmds_r[3]), .D4(tmds_r[4]),
        .D5(tmds_r[5]), .D6(tmds_r[6]), .D7(tmds_r[7]), .D8(tmds_r[8]), .D9(tmds_r[9]),
        .PCLK(clk), .FCLK(clk_{{mul (mhz .ClockFreq) 5}}m), .RESET(~lock)
    );
    defparam oser_r.GSREN = "false";
    defparam oser_r.LSREN = "false";
    TLVDS_OBUF tlvds_r (.O(tmds_d_p[2]), .OB(tmds_d_n[2]), .I(tmds_serial[2]));

    // Clock channel
    (* IOLOGIC_FCLK="clk_{{mul (mhz .ClockFreq) 5}}m" *)
    OSER10 oser_clk (
        .Q(clk_serial),
        .D0(1'b0), .D1(1'b0), .D2(1'b0), .D3(1'b0), .D4(1'b0),
        .D5(1'b1), .D6(1'b1), .D7(1'b1), .D8(1'b1), .D9(1'b1),
        .PCLK(clk), .FCLK(clk_{{mul (mhz .ClockFreq) 5}}m), .RESET(~lock)
    );
    defparam oser_clk.GSREN = "false";
    defparam oser_clk.LSREN = "false";
    TLVDS_OBUF tlvds_clk (.O(tmds_clk_p), .OB(tmds_clk_n), .I(clk_serial));

endmodule
